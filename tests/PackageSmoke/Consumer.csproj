<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <ControlBatyrDocumentationDirectory>docs</ControlBatyrDocumentationDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ControlBatyr" Version="$(ControlBatyrPackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
    <PackageReference Include="ControlBatyr.Connections" Version="$(ControlBatyrPackageVersion)" />
    <PackageReference Include="ControlBatyr.Requirements" Version="$(ControlBatyrPackageVersion)" />
    <PackageReference Include="ControlBatyr.Rules" Version="$(ControlBatyrPackageVersion)" PrivateAssets="all" Condition="'$(UseRules)' == 'true'" />
    <PackageReference Include="ControlBatyr.Inspection" Version="$(ControlBatyrPackageVersion)" PrivateAssets="all" />
  </ItemGroup>
</Project>
