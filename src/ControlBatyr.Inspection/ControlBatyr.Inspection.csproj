<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ControlBatyr.Inspection</PackageId>
    <Description>Generates business API documentation from ControlBatyr cores and requirements at build time.</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
    <OutputType>Exe</OutputType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackInspectionTool</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ControlBatyr/ControlBatyr.csproj" />
    <ProjectReference Include="../ControlBatyr.Requirements/ControlBatyr.Requirements.csproj" />
    <None Include="build/ControlBatyr.Inspection.targets" Pack="true" PackagePath="build/" />
    <None Include="build/ControlBatyr.Inspection.props" Pack="true" PackagePath="build/" />
    <InternalsVisibleTo Include="ControlBatyr.Tests" />
    <InternalsVisibleTo Include="ControlBatyr.Rules" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>
  <Target Name="PackInspectionTool">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetDir)*.dll;$(TargetDir)*.json">
        <PackagePath>tools/$(TargetFramework)/any/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
