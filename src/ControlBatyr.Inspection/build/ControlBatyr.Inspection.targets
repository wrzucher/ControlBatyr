<Project>
  <PropertyGroup>
    <ControlBatyrDocumentationDirectory Condition="'$(ControlBatyrDocumentationDirectory)' == ''">docs/business-api</ControlBatyrDocumentationDirectory>
    <ControlBatyrToolPath Condition="'$(ControlBatyrToolPath)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/any/ControlBatyr.Inspection.dll</ControlBatyrToolPath>
  </PropertyGroup>
  <Target Name="GenerateControlBatyrBusinessApi" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <ControlBatyrAssemblies Condition="'$(ControlBatyrAssemblies)' == ''">$(TargetPath)</ControlBatyrAssemblies>
    </PropertyGroup>
    <ItemGroup>
      <_ControlBatyrAssembly Include="$(ControlBatyrAssemblies)" />
      <!-- Runtime assets exist even when a class library does not copy NuGet dependencies.
           Compile assets may be ref assemblies; shared frameworks come from the tool host. -->
      <_ControlBatyrReference Include="@(RuntimeCopyLocalItems)" />
      <_ControlBatyrReference Include="@(ReferenceCopyLocalPaths)" />
      <_ControlBatyrReference Include="@(RuntimeTargetsCopyLocalItems)"
                              Condition="'%(RuntimeTargetsCopyLocalItems.AssetType)' == 'runtime'" />
      <_ControlBatyrReference Include="@(ReferencePath)"
                              Condition="'%(ReferencePath.FrameworkReferenceName)' == '' and '%(ReferencePath.NuGetPackageId)' == ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)controlbatyr-assemblies.txt"
                      Lines="@(_ControlBatyrAssembly->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)controlbatyr-references.txt"
                      Lines="@(_ControlBatyrReference->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="dotnet &quot;$(ControlBatyrToolPath)&quot; &quot;$(ControlBatyrDocumentationDirectory)&quot; &quot;$(IntermediateOutputPath)controlbatyr-assemblies.txt&quot; &quot;$(IntermediateOutputPath)controlbatyr-references.txt&quot; &quot;$(ControlBatyrRulesPath)&quot; &quot;$(ControlBatyrCheckDocuments)&quot; &quot;$(ControlBatyrOutputs)&quot;" />
  </Target>
</Project>
